<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CS1591: missing XML doc comment. This is an application, not a documented library. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Reproducibility and source indexing. SourceLink ships in the SDK on .NET 8+, so there is
       deliberately no SourceLink PackageReference here. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- CHANGELOG.md is the version authority: the Fallout build parses its top section and
       overrides VersionPrefix on the command line. The value below is only the local fallback. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Marko Lahma</Authors>
    <Company>Marko Lahma</Company>
    <Product>Roslyn LSP adapter for Claude Code</Product>
    <Copyright>Copyright (c) 2026 Marko Lahma</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lahma/claude-roslyn-lsp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lahma/claude-roslyn-lsp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
