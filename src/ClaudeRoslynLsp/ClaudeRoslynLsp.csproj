<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>claude-roslyn-lsp</AssemblyName>
    <RootNamespace>ClaudeRoslynLsp</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StripSymbols>true</StripSymbols>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Required for IDE0005 (unnecessary usings) to run under EnforceCodeStyleInBuild;
         CS1591 is silenced centrally. See https://github.com/dotnet/roslyn/issues/41640. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Not a licence to write unsafe code: the [LibraryImport] source generator emits `unsafe`
         marshalling stubs and refuses to compile without this (SYSLIB1062). It is the price of
         Roslyn/ChildProcessGuard.cs's job object being AOT-safe - [DllImport] would compile here
         and then trip IL2026/IL3050, which this repository promotes to errors. No hand-written
         `unsafe` block exists in the product, and adding one would need its own argument. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- D22: the NuGet channel is what the Claude Code plugin launches - both of its entries run
       `dnx claude-roslyn-lsp@{version}`, one ending in `lsp` and one in `mcp`. Since 1.0.0 it delivers
       the same Native AOT binary as the GitHub Releases, as RID-specific tool packages: `dotnet pack`
       builds the pointer package, which names one package per RID below, `dotnet pack -r <rid>` builds
       each of those on a runner of that OS (Native AOT cannot cross-compile across operating systems),
       and `dotnet pack -r any -p:PublishAot=false` builds the framework-dependent fallback for every
       other platform - which includes the three Roslyn RIDs no archive is built for (D24).
       PackageType McpServer is what nuget.org filters on to show the MCP tab and generate client
       configuration; PackAsTool already makes it a tool package, so DotnetTool is deliberately NOT
       listed alongside it (the mcpserver template does the same). The SDK gives the RID packages the
       DotnetToolRidPackage type instead, so only the pointer carries McpServer - which matters,
       because nuget.org refuses a McpServer package that is not also a DotnetTool. The package id,
       the assembly name, the tool command and the plugin name are all the same string. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <PackageId>claude-roslyn-lsp</PackageId>
    <ToolCommandName>claude-roslyn-lsp</ToolCommandName>
    <!-- The `any` fallback package is framework-dependent, so it must keep working on a runtime newer
         than the one it was built against. -->
    <RollForward>Major</RollForward>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>lsp;language-server;roslyn;csharp;dotnet;refactoring;claude-code;mcp;mcp-server;model-context-protocol;stdio</PackageTags>
    <Description>Roslyn C# language server adapter for Claude Code and other agents. Runs as an LSP server (`claude-roslyn-lsp lsp`) that mediates Microsoft's roslyn-language-server so navigation and edit-time diagnostics work reliably, and as an MCP server (`claude-roslyn-lsp mcp`) that exposes semantic refactoring - rename, code actions, fix-all, formatting and on-demand diagnostics - to models that would otherwise reach for grep and sed. `dnx claude-roslyn-lsp` runs the Native AOT binary on Windows, Linux and macOS (x64 and Arm64 where built) and a framework-dependent build elsewhere. Pure BCL, no compiler packages of its own.</Description>
  </PropertyGroup>

  <!-- The RIDs the pointer package names: exactly the release matrix's five legs (ToolPackageTests
       keeps the two lists equal), plus `any` for the framework-dependent fallback. Not
       RuntimeIdentifiers (D8): this property only shapes the tool packages and restores nothing per
       RID. PublishAot is unconditional: with it set, a RID-less `dotnet pack` builds the pointer
       alone, where with it false the same command packs every RID package framework-dependent
       under the native names. It also keeps the AOT, trim and single-file analyzers on for every
       build, `dotnet build` and `dotnet test` included, so an AOT-hostile line (IL2026, IL3050) is a
       build error under TreatWarningsAsErrors without stating them separately. A published tool
       needs neither symbols nor the XML docs, and Native AOT's symbols alone are ~100 MB on Windows,
       so neither is copied to publish output - the archives never shipped them either. -->
  <PropertyGroup>
    <ToolPackageRuntimeIdentifiers>linux-x64;linux-arm64;win-x64;win-arm64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed into the package root as /.mcp/server.json, which is where nuget.org looks for the
         MCP server manifest. Both files live at the repository root - one server manifest per
         repository, and the same README.md the AOT archives ship - so they are referenced from
         there rather than duplicated under src/. -->
    <None Include="../../.mcp/server.json" Pack="true" PackagePath="/.mcp/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!-- Deliberately absent (D8): RuntimeIdentifiers (would pull ILCompiler packs per RID on every
       restore - the RID reaches publish via -r), PublishSingleFile (ignored under AOT) and
       SelfContained (implied by PublishAot). -->

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeRoslynLsp.Tests" />
  </ItemGroup>

  <!-- The whole package budget for the product. No Microsoft.CodeAnalysis.*, ever (D1): the
       compiler runs in the child process this adapter launches, never in this one. -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
