<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- NUnit3TestAdapter's Microsoft.Testing.Platform runner: the project builds to a test
         executable that `dotnet test` drives directly, with no VSTest host. -->
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <!-- D6: the same reflection-free serializer contract as the product, so a missing
         [JsonSerializable] fails in `dotnet test` and not only after an AOT publish. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Required for IDE0005 under EnforceCodeStyleInBuild; see the server csproj. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ClaudeRoslynLsp/ClaudeRoslynLsp.csproj" />
  </ItemGroup>

</Project>
